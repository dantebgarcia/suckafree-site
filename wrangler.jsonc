{
  // Cloudflare Worker for suckafree.org.
  // Pages and images live in ./public and are served as-is.
  // src/worker.js handles /api/* (email sign-ups) and /admin (the sign-up list).
  // Every push to main redeploys.
  "name": "suckafree-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Email sign-ups. Cloudflare creates this database on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "suckafree-signups" }
  ],
  "observability": { "enabled": true }
}

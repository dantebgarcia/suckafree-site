{
  // Cloudflare Worker that serves the Sucka Free Collective site.
  // Static files live in ./public. Every push to main redeploys.
  "name": "suckafree-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
